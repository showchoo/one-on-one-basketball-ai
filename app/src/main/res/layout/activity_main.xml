<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <jp.showchoo.oneononeai.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topScoreboard"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="@drawable/hud_scoreboard_bg"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textColor="@color/player_a"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/playerA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="-"
                android:textColor="@color/hud_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B"
                android:textColor="@color/player_b"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/playerB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="1ON1 / 10"
                android:textColor="@color/basketball_orange"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="SETUP / リング位置を設定"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/perfText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="AI -- ms"
            android:textColor="#8FA0B2"
            android:textSize="8sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/hud_panel_bg"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                style="@style/Widget.OneOnOneAI.Button.Primary"
                android:layout_width="124dp"
                android:layout_height="46dp"
                android:text="▶ START"
                android:textSize="15sp"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                style="@style/Widget.OneOnOneAI.Button.Secondary"
                android:layout_width="96dp"
                android:layout_height="46dp"
                android:layout_marginStart="7dp"
                android:text="RESET"
                android:textColor="#FF8C8C"
                app:strokeColor="#88D94343" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/controlsToggleButton"
                style="@style/Widget.OneOnOneAI.Button.Secondary"
                android:layout_width="112dp"
                android:layout_height="46dp"
                android:layout_marginStart="7dp"
                android:text="操作を閉じる" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_chip_bg"
                android:text="AUTO REF"
                android:textColor="@color/basketball_orange"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/commentaryButton"
                style="@style/Widget.OneOnOneAI.Button.Secondary"
                android:layout_width="132dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:text="実況: ON"
                android:textColor="@color/basketball_orange"
                app:strokeColor="@color/basketball_orange" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COURT / VOICE"
                android:textColor="@color/hud_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calibrateHoopButton"
                    style="@style/Widget.OneOnOneAI.Button.Secondary"
                    android:layout_width="102dp"
                    android:layout_height="42dp"
                    android:text="◎ リング" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calibrateThreeButton"
                    style="@style/Widget.OneOnOneAI.Button.Secondary"
                    android:layout_width="104dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:text="⌒ 3Pライン" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/voiceSettingsButton"
                    style="@style/Widget.OneOnOneAI.Button.Secondary"
                    android:layout_width="88dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:text="TTS" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mcVoicePackButton"
                    style="@style/Widget.OneOnOneAI.Button.Secondary"
                    android:layout_width="104dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:text="MC試聴" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/debugLogButton"
                    style="@style/Widget.OneOnOneAI.Button.Secondary"
                    android:layout_width="118dp"
                    android:layout_height="42dp"
                    android:text="ログ共有"
                    android:textColor="@color/basketball_orange"
                    app:strokeColor="@color/basketball_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="MANUAL"
                    android:textColor="@color/hud_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/a1Button"
                    style="@style/Widget.OneOnOneAI.Button.ScoreA"
                    android:layout_width="68dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="A +1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/a2Button"
                    style="@style/Widget.OneOnOneAI.Button.ScoreA"
                    android:layout_width="68dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:text="A +2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b1Button"
                    style="@style/Widget.OneOnOneAI.Button.ScoreB"
                    android:layout_width="68dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="B +1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/b2Button"
                    style="@style/Widget.OneOnOneAI.Button.ScoreB"
                    android:layout_width="68dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:text="B +2" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
