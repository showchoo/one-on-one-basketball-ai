<resources>
    <style name="Widget.OneOnOneAI.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/basketball_orange</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.OneOnOneAI.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/hud_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/hud_black_soft</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.OneOnOneAI.Button.ScoreA" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#07140D</item>
        <item name="backgroundTint">@color/player_a</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">74dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.OneOnOneAI.Button.ScoreB" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#21041B</item>
        <item name="backgroundTint">@color/player_b</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">74dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>
